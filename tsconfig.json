{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "svelte", "vite/client"],
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "site/**/*.ts",
    "site/**/*.svelte",
    "test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["scripts/canaries/**"]
}
