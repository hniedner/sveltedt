#!/bin/sh
# One-time set-up of a clone: git runs the hooks in .githooks/ (CONTRIBUTING, "Commit headers"). It stops and changes
# nothing when core.hooksPath is already set to another value, in this clone or in a global file.
set -eu
cd "$(dirname "$0")/.."
tab=$(printf '\t')
found=$(git config --show-origin --get core.hooksPath || true)
if [ -n "$found" ]; then
  value=${found#*"$tab"}
  where=${found%%"$tab"*}
  if [ "$value" != .githooks ]; then
    echo "setup: core.hooksPath is \"$value\" ($where); not changed. To use .githooks in this clone, run: git config core.hooksPath .githooks. That replaces the other value here, and its hooks then stop running in this clone." >&2
    exit 1
  fi
  echo "setup: core.hooksPath is already .githooks"
  exit 0
fi
git config core.hooksPath .githooks
echo "setup: core.hooksPath set to .githooks"
