{
  "name": "@hniedner/sveltedt",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    },
    "./connection": {
      "types": "./src/lib/connection/index.ts",
      "svelte": "./src/lib/connection/index.ts"
    },
    "./styles.css": "./src/lib/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js"
      },
      "./connection": {
        "types": "./dist/connection/index.d.ts",
        "svelte": "./dist/connection/index.js"
      },
      "./styles.css": {
        "style": "./dist/styles.css",
        "default": "./dist/styles.css"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "LICENSE",
    "NOTICE"
  ],
  "packageManager": "pnpm@12.19.0",
  "scripts": {
    "gate": "node scripts/check-repo.ts all",
    "test": "vitest run",
    "site:build": "vite build --config site/vite.config.ts",
    "site:serve": "node site/server.ts"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ]
  },
  "dependencies": {
    "esm-env": "^1.2.1"
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@sveltejs/package": "3.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-svelte": "3.24.1",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "parse5": "8.1.1",
    "postcss": "8.5.33",
    "postcss-selector-parser": "7.2.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.25",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
